# /etc/udev/rules.d/70-synaptics-bio.rules
# Synaptics / Validity 06cb:0081 fingerprint sensor access and autosuspend management
# MODE="0666" and TAG+="uaccess" are required so desktop user sessions (KDE Plasma screen locker)
# can access the USB sensor via libusb in rootless userland.
SUBSYSTEM=="usb", ATTRS{idVendor}=="06cb", ATTRS{idProduct}=="0081", MODE="0666", TAG+="uaccess", TEST=="power/control", ATTR{power/control}="on"
