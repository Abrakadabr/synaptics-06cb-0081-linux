# /etc/udev/rules.d/70-synaptics-bio.rules
# Synaptics / Validity 06cb:0081 fingerprint sensor access and autosuspend management
# MODE="0660" and TAG+="uaccess" grant libusb access strictly to root and the active physical
# desktop seat user (KDE Plasma screen locker), blocking SSH/remote and background accounts.
SUBSYSTEM=="usb", ATTRS{idVendor}=="06cb", ATTRS{idProduct}=="0081", MODE="0660", TAG+="uaccess", TEST=="power/control", ATTR{power/control}="on"
