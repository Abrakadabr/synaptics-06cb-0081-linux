#!/usr/bin/env python3
# /usr/local/bin/synaptics-bio-enroll
# Enrollment utility for Synaptics 06cb:0081 Match-on-Chip sensor
# Supports multi-user isolation with per-user identity tagging and multi-finger slots

import atexit
import json
import os
import pwd
import re
import signal
import subprocess
import sys
import time


def _load_common():
    script_path = os.path.abspath(__file__)
    if script_path.startswith("/usr/local/bin/") or script_path.startswith("/usr/bin/"):
        search_dirs = ["/opt/synaptics-bio"]
    else:
        repo_lib = os.path.join(os.path.dirname(os.path.dirname(script_path)), "lib")
        search_dirs = [repo_lib, "/opt/synaptics-bio"]
    for d in search_dirs:
        if os.path.isdir(d) and d not in sys.path:
            sys.path.insert(0, d)


_load_common()

import synaptics_bio_common as bio  # noqa: E402


def get_next_finger_id(opt_dir, target_user):
    cfg_file = os.path.join(opt_dir, "identities.json")
    if os.path.exists(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as f:
                data = json.load(f)
            meta = data.get("_metadata", {}).get(target_user, {})
            enrolled = meta.get("enrolled_fingers", [])
            for fid in range(1, 11):
                if fid not in enrolled:
                    return fid
        except Exception:
            pass
    return 1


def print_usage():
    print("Usage:")
    print("  sudo synaptics-bio-enroll [username] [slot 1-10]")
    print("")
    print("Examples:")
    print("  sudo synaptics-bio-enroll")
    print("  sudo synaptics-bio-enroll kate 1")
    print("  sudo synaptics-bio-enroll kate 2")


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print_usage()
        sys.exit(0)

    if os.geteuid() != 0:
        print("Error: synaptics-bio-enroll must be run as root (use sudo).", file=sys.stderr)
        sys.exit(1)

    opt_dir = bio.resolve_opt_dir(__file__)
    if not opt_dir:
        print("Error: /opt/synaptics-bio directory not found.", file=sys.stderr)
        sys.exit(1)

    # Parse CLI arguments strictly
    target_user = None
    finger_id = None
    for arg in args:
        if arg.startswith("-"):
            print(f"Error: Unknown option '{arg}'.", file=sys.stderr)
            print_usage()
            sys.exit(1)
        elif arg.isdigit():
            val = int(arg)
            if not (1 <= val <= 10):
                print(f"Error: Finger slot must be between 1 and 10 (got '{arg}').", file=sys.stderr)
                sys.exit(1)
            finger_id = val
        elif target_user is None:
            target_user = arg
        else:
            print(f"Error: Unexpected argument '{arg}'.", file=sys.stderr)
            print_usage()
            sys.exit(1)

    if not target_user:
        target_user = os.environ.get("SUDO_USER") or os.environ.get("USER")
    if not target_user:
        try:
            target_user = pwd.getpwuid(os.getuid()).pw_name
        except Exception:
            target_user = None

    if not target_user or target_user == "root":
        print("Error: Target user could not be determined. Please specify a username:", file=sys.stderr)
        print("  sudo synaptics-bio-enroll <username> [slot 1-10]", file=sys.stderr)
        sys.exit(1)

    try:
        user_info = pwd.getpwnam(target_user)
        target_uid = user_info.pw_uid
    except KeyError:
        print(f"Error: User '{target_user}' does not exist on this system.", file=sys.stderr)
        print(f"Please create the user account first (e.g. sudo useradd {target_user}).", file=sys.stderr)
        sys.exit(1)

    if finger_id is None:
        finger_id = get_next_finger_id(opt_dir, target_user)

    base_enroll_exe = os.path.join(opt_dir, "enroll.exe")
    if not os.path.exists(base_enroll_exe):
        print(f"Error: {base_enroll_exe} not found.", file=sys.stderr)
        sys.exit(1)

    # Acquire hardware mutex lock
    lock_fd = bio.acquire_hardware_lock(mode="interactive", timeout=3.0)
    if not lock_fd:
        print("Error: Another biometric process is currently accessing the sensor. Please wait and try again.", file=sys.stderr)
        sys.exit(1)

    pid = os.getpid()
    container_name = f"synaptics-bio-enroll-{pid}"
    patched_exe_name = f"enroll-{target_uid}-{pid}.exe"
    patched_exe_path = os.path.join(opt_dir, patched_exe_name)
    trace_file = f"usb-trace-{pid}.txt"
    trace_path = os.path.join(opt_dir, trace_file)
    clean_env = bio.get_clean_env(0)

    def cleanup():
        try:
            subprocess.run(
                ["podman", "rm", "-f", container_name],
                env=clean_env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3,
            )
        except Exception:
            pass
        for tmp_f in (patched_exe_path, trace_path):
            if os.path.exists(tmp_f):
                try:
                    os.remove(tmp_f)
                except Exception:
                    pass
        bio.release_hardware_lock(lock_fd)

    atexit.register(cleanup)

    def sig_handler(signum, frame):
        sys.exit(1)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)
    try:
        signal.signal(signal.SIGHUP, sig_handler)
    except Exception:
        pass

    log_file = "/var/log/synaptics-bio-enroll.log"
    if not os.access(os.path.dirname(log_file), os.W_OK):
        log_file = os.path.join(bio.RUN_BIO_DIR, "enroll.log")

    print("==========================================================")
    print("   Synaptics Fingerprint Sensor Enrollment")
    print("==========================================================")
    print(f"Target User : {target_user} (UID: {target_uid})")
    print(f"Finger Slot : #{finger_id} (Slot 1-10)")
    print("")
    print("Instructions:")
    print("1. When prompted, place your finger centered on the sensor.")
    print("2. When accepted, lift your finger and touch again.")
    print("3. Repeat touches (approx. 8-10 times) until complete.")
    print("==========================================================")
    print("")

    # 1. Clean up stale root-owned wine processes/containers
    subprocess.run(["pkill", "-u", "0", "-x", "identify.exe"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["pkill", "-u", "0", "-x", "enroll.exe"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["podman", "rm", "-f", container_name], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 2. Disable USB autosuspend dynamically across sysfs
    bio.ensure_usb_powered()

    # 3. Reset USB device to ensure clean state
    print("[Fingerprint] Initializing sensor hardware...", flush=True)
    try:
        subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    time.sleep(1.5)

    # 4. Locate USB device node dynamically
    dev_path = bio.get_usb_dev_path()
    if not dev_path or not os.path.exists(dev_path):
        print("Error: Synaptics 06cb:0081 sensor not found on USB.", file=sys.stderr)
        sys.exit(1)

    # 5. Validate and patch enrollment binary with unique RID and SubFactor
    try:
        bio.patch_enroll_binary(base_enroll_exe, patched_exe_path, target_user, target_uid, finger_id)
    except ValueError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    image = bio.find_container_image(clean_env)

    cmd = [
        "podman", "run", "--rm",
        "--init",
        "--name", container_name,
        "--net=none",
        "--cap-drop=ALL",
        "--security-opt", "label=disable",
        "--device", dev_path,
        "-e", "WINEPATH=/usr/lib/gcc/x86_64-w64-mingw32/10-win32;/usr/x86_64-w64-mingw32/lib",
        "-e", "WINEDEBUG=fixme-all,err-all,trace+winusb",
        "-w", opt_dir,
        "-e", f"USB_SCRIPT={trace_file}",
        "-v", f"{opt_dir}:{opt_dir}",
        image,
        "sh", "-c",
        'mkdir -p /root/.wine/drive_c && cp "$1/usb.txt" /root/.wine/drive_c/usb.txt && exec wine64 "./$2" enroll',
        "_", opt_dir, patched_exe_name,
    ]

    proc = None
    accepted_samples = 0
    total_samples = 6
    saw_commit_ioctl = False
    commit_complete_ok = False
    commit_got_reply = False

    bio.secure_append_log(
        log_file,
        f"\n--- Enrollment started at {time.ctime()} (User: {target_user}, UID: {target_uid}, Finger: #{finger_id}) ---\n",
    )

    try:
        proc = subprocess.Popen(
            cmd,
            env=clean_env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            bufsize=1,
        )

        for line in proc.stdout:
            bio.secure_append_log(log_file, line)

            if "about to IOCTL_BIOMETRIC_CAPTURE_DATA" in line:
                prompt_num = min(accepted_samples + 1, total_samples)
                print(f"[Fingerprint Enrollment] Touch sensor with finger to register (Sample #{prompt_num}/{total_samples})...", flush=True)

            elif "SensorStatus 2" in line:
                print("[Fingerprint Enrollment] Touch not detected or released too quickly. Please touch again.", flush=True)

            elif "Got back 0x2c bytes:" in line:
                m = re.search(r"Got back 0x2c bytes:\s*([0-9a-fA-F]+)", line)
                if m:
                    hex_data = m.group(1).lower()
                    status_hex = hex_data[:8]
                    try:
                        progress_pct = int(hex_data[72:74], 16) if len(hex_data) >= 74 else 0
                    except ValueError:
                        progress_pct = 0

                    if status_hex == "01000900":  # WINBIO_I_MORE_DATA
                        accepted_samples += 1
                        if accepted_samples >= total_samples and progress_pct < 100:
                            total_samples = accepted_samples + 1
                        print(f"[Fingerprint Enrollment] Sample #{accepted_samples}/{total_samples} accepted ({progress_pct}%). Lift finger.", flush=True)

                    elif status_hex == "00000000":  # S_OK
                        accepted_samples = total_samples
                        print(f"[Fingerprint Enrollment] Sample #{total_samples}/{total_samples} accepted (100%). Lift finger.", flush=True)

                    elif status_hex == "08800980":  # WINBIO_E_BAD_CAPTURE
                        print("[Fingerprint Enrollment] Poor quality touch or bad capture. Please adjust finger and try again.", flush=True)

                    elif status_hex == "0a800980":  # WINBIO_E_DUPLICATE_SAMPLE
                        print("[Fingerprint Enrollment] Duplicate sample. Please shift finger angle slightly and try again.", flush=True)

                    else:
                        print(f"[Fingerprint Enrollment] Sample not accepted (status 0x{status_hex}). Please try again.", flush=True)

            elif "about to Commit Enrollment" in line:
                saw_commit_ioctl = True
                print("\n[Fingerprint] All samples collected. Committing template to sensor...", flush=True)

            elif saw_commit_ioctl and line.strip() == "Complete: 0":
                commit_complete_ok = True

            elif saw_commit_ioctl and "Got back 0x1 bytes:" in line:
                commit_got_reply = True

        proc.wait()

    except KeyboardInterrupt:
        print("\n[Fingerprint] Enrollment canceled by user.", flush=True)
    except Exception as e:
        print(f"\n[Fingerprint] Error during enrollment: {e}", file=sys.stderr)
    finally:
        if proc and proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        subprocess.run(["podman", "rm", "-f", container_name], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for tmp_f in (patched_exe_path, trace_path):
            if os.path.exists(tmp_f):
                try:
                    os.remove(tmp_f)
                except Exception:
                    pass

        try:
            subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass

    committed = saw_commit_ioctl and commit_complete_ok and commit_got_reply and (proc is not None and proc.returncode == 0)
    if committed:
        try:
            bio.update_identities_file(opt_dir, target_user, finger_id)
        except Exception as e:
            print(f"Warning: could not update identities.json: {e}", file=sys.stderr)
        print("")
        print("==========================================================")
        print(f"Enrollment complete for user '{target_user}' (Finger #{finger_id})")
        print("Biometric template committed to on-chip secure storage.")
        print("You can verify immediately with:")
        print("  sudo -k && sudo whoami")
        print("==========================================================")
        sys.exit(0)
    else:
        print("\n[Fingerprint] Enrollment was not completed.")
        sys.exit(1)


if __name__ == "__main__":
    main()
