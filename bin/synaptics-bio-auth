#!/usr/bin/env python3
# /usr/local/bin/synaptics-bio-auth
# Biometric PAM helper for Synaptics 06cb:0081 Match-on-Sensor
# Supports multi-user isolation with SID RID (UID) and identity verification

import atexit
import json
import os
import pwd
import select
import signal
import subprocess
import sys
import time


def _load_common():
    script_path = os.path.abspath(__file__)
    if script_path.startswith("/usr/local/bin/") or script_path.startswith("/usr/bin/"):
        search_dirs = ["/opt/synaptics-bio"]
    else:
        repo_lib = os.path.join(os.path.dirname(os.path.dirname(script_path)), "lib")
        search_dirs = [repo_lib, "/opt/synaptics-bio"]
    for d in search_dirs:
        if os.path.isdir(d) and d not in sys.path:
            sys.path.insert(0, d)


_load_common()

import synaptics_bio_common as bio  # noqa: E402


def _boottime_delta():
    """Return CLOCK_BOOTTIME - CLOCK_MONOTONIC (jumps only across real system suspend)."""
    if hasattr(time, "CLOCK_BOOTTIME"):
        return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
    return 0.0


def _build_container_mounts(opt_dir, uid=None):
    """
    Build container volume mounts protecting binaries and identities.json read-only.
    Non-root callers or runs where CalibrationData.blob already exists always mount
    opt_dir completely read-only.
    """
    if uid is None:
        uid = os.geteuid()
    cal_blob = os.path.join(opt_dir, "CalibrationData.blob")
    if uid != 0 or os.path.isfile(cal_blob):
        return ["-v", f"{opt_dir}:{opt_dir}:ro"]

    mounts = ["-v", f"{opt_dir}:{opt_dir}"]
    ro_files = (
        "identities.json",
        "identify.exe",
        "enroll.exe",
        "synawudfbiousb.dll",
        "synaAdvAdapter.dll",
        "synaptics_bio_common.py",
        "usb.txt",
    )
    for fname in ro_files:
        fpath = os.path.join(opt_dir, fname)
        if os.path.isfile(fpath):
            mounts.extend(["-v", f"{fpath}:{fpath}:ro"])
    return mounts


def main():
    lockscreen_mode = "--lockscreen" in sys.argv
    compact_mode = "--compact" in sys.argv
    quiet_mode = "--quiet" in sys.argv
    cli_args = [arg for arg in sys.argv[1:] if not arg.startswith("-")]

    target_user = None
    if cli_args:
        target_user = cli_args[0]
    if not target_user:
        target_user = os.environ.get("PAM_USER")
    if not target_user:
        target_user = os.environ.get("SUDO_USER")
    if not target_user:
        target_user = os.environ.get("USER")
    if not target_user:
        try:
            target_user = pwd.getpwuid(os.getuid()).pw_name
        except Exception:
            target_user = None

    if not target_user:
        sys.exit(1)

    # Check for global bypass flag in root-controlled /run
    if os.path.exists("/run/synaptics-bio/disable-bio-auth"):
        sys.exit(1)

    # Check for user-specific bypass flag
    try:
        target_pw = pwd.getpwnam(target_user)
        if os.path.exists(f"/run/user/{target_pw.pw_uid}/disable-bio-auth"):
            sys.exit(1)
    except Exception:
        pass

    # Load configured allowed biometric identities for this user BEFORE touching hardware.
    # Fail closed: unenrolled users immediately fall back to password without waking the sensor.
    opt_dir = bio.resolve_opt_dir(__file__)
    if not opt_dir:
        sys.exit(1)

    config_file = os.path.join(opt_dir, "identities.json")
    ident_map = {}
    if os.path.exists(config_file):
        try:
            with open(config_file, "r", encoding="utf-8") as f_cfg:
                ident_map = json.load(f_cfg)
        except Exception:
            ident_map = {}

    auth_rules, all_identities, uid_to_user = bio.build_auth_policy(ident_map, target_user)
    if not auth_rules:
        sys.exit(1)

    # If system suspend/resume is in progress, wait until post-resume usbreset finishes
    for _ in range(50):
        if not os.path.exists("/run/synaptics-bio/suspending"):
            break
        time.sleep(0.2)

    # If running with root effective privileges under PAM (e.g. setuid polkit-agent-helper-1),
    # adopt full root real UID/GID BEFORE acquiring locks, spawning Podman, or checking /var/log.
    if os.geteuid() == 0:
        try:
            os.setgid(0)
            os.setuid(0)
        except Exception:
            pass

    # Acquire hardware mutex lock to prevent concurrent sensor access collisions
    auth_mode = "lockscreen" if lockscreen_mode else "interactive"
    lock_fd = bio.acquire_hardware_lock(mode=auth_mode, timeout=3.5)
    if not lock_fd:
        sys.exit(1)

    uid = os.geteuid()
    pid = os.getpid()
    initial_ppid = os.getppid()
    container_name = f"synaptics-bio-auth-{pid}"
    podman_base = ["podman"]
    container_state = {"needs_rm": False}

    # Sanitize environment unconditionally to isolate Podman & Wine from user sessions
    clean_env = bio.get_clean_env(uid)
    for var in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "XDG_SESSION_ID", "XDG_DATA_DIRS"):
        os.environ.pop(var, None)
    os.environ["HOME"] = clean_env["HOME"]
    os.environ["PATH"] = clean_env["PATH"]

    def cleanup():
        # Stop/remove container BEFORE releasing the hardware lock if still potentially active
        if container_state["needs_rm"]:
            try:
                subprocess.run(
                    podman_base + ["rm", "-f", container_name],
                    env=clean_env,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=3,
                )
            except Exception:
                pass
            container_state["needs_rm"] = False
        bio.release_hardware_lock(lock_fd)

    atexit.register(cleanup)

    def sig_handler(signum, frame):
        sys.exit(1)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)
    try:
        signal.signal(signal.SIGHUP, sig_handler)
    except Exception:
        pass

    if uid == 0:
        log_file = "/var/log/synaptics-bio-auth.log"
        if not os.access(os.path.dirname(log_file), os.W_OK, effective_ids=True):
            log_file = os.path.join(bio.RUN_BIO_DIR, "auth.log")
    else:
        user_run = f"/run/user/{uid}"
        if os.path.isdir(user_run) and os.access(user_run, os.W_OK, effective_ids=True):
            log_file = os.path.join(user_run, "synaptics-bio-auth.log")
        else:
            log_file = None

    def write_log(msg):
        if log_file:
            bio.secure_append_log(log_file, msg)

    # Rotate log if larger than 1MB to prevent unbounded growth
    if log_file:
        try:
            if os.path.exists(log_file) and not os.path.islink(log_file) and os.path.getsize(log_file) > 1024 * 1024:
                with open(log_file, "r", encoding="utf-8", errors="replace") as f_prev:
                    prev_lines = f_prev.readlines()
                fd_rot = os.open(log_file, os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd_rot, "w", encoding="utf-8") as f_prev:
                    f_prev.writelines(prev_lines[-1000:])
        except Exception:
            pass

    rule_summary = [f"{r['alias']}(uid={r['uid']})" for r in auth_rules]
    write_log(f"\n--- Auth attempt at {time.ctime()} (PID {pid}) ---\n")
    write_log(f"Target User: {target_user} (Authorized Rules: {rule_summary})\n")
    write_log(f"UID={os.getuid()} EUID={os.geteuid()}\n")

    if not quiet_mode:
        print(f"[Fingerprint] Sensor initializing for {target_user} (~5s)...", flush=True)

    # 1. Clean up stale identify.exe processes owned by this UID
    subprocess.run(
        ["pkill", "-u", str(uid), "-x", "identify.exe"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    # 2. Ensure USB device is awake
    bio.ensure_usb_powered()

    # 3. Reset USB device to ensure cryptoprocessor starts in State 0
    try:
        subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    time.sleep(1.5)

    # 4. Locate USB device node dynamically
    dev_path = bio.get_usb_dev_path()
    if not dev_path or not os.path.exists(dev_path):
        write_log("Device 06cb:0081 not found\nResult: FAIL/FALLBACK\n")
        sys.exit(1)

    try:
        os.chdir(opt_dir)
    except Exception:
        pass

    image = bio.find_container_image(clean_env, podman_base)
    container_mounts = _build_container_mounts(opt_dir, uid)

    success = False
    matched_identity = None
    matched_rid = None
    wrong_user_desc = None
    max_attempts = 3
    max_suspend_resets = 2
    suspend_resets = 0
    attempt = 0
    start_time = time.monotonic()
    total_timeout = 30.0

    while attempt < max_attempts:
        attempt += 1
        elapsed = time.monotonic() - start_time
        remaining = total_timeout - elapsed
        if remaining <= 3:
            write_log(f"Insufficient time remaining ({remaining:.1f}s) for attempt {attempt}\n")
            break

        write_log(f"--- Scan Session Attempt {attempt}/{max_attempts} (Time remaining: {remaining:.1f}s) ---\n")

        # On retries, clean up previous container and give the USB bus a brief moment to reset
        if attempt > 1:
            subprocess.run(
                ["pkill", "-u", str(uid), "-x", "identify.exe"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            subprocess.run(
                podman_base + ["rm", "-f", container_name],
                env=clean_env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            try:
                subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            except Exception:
                pass
            time.sleep(1.0)

        dev_path = bio.get_usb_dev_path()
        if not dev_path or not os.path.exists(dev_path):
            write_log("Device 06cb:0081 not found during retry\n")
            break

        cmd = (
            podman_base
            + [
                "run", "--rm",
                "--init",
                "--name", container_name,
                "--net=none",
                "--cap-drop=ALL",
                "--security-opt", "label=disable",
                "--tmpfs", "/tmp:rw,nosuid,nodev,mode=1777",
                "--device", dev_path,
                "-e", "HOME=/tmp",
                "-e", "WINEPREFIX=/tmp/.wine",
                "-e", "WINEPATH=/usr/lib/gcc/x86_64-w64-mingw32/10-win32;/usr/x86_64-w64-mingw32/lib",
                "-e", "WINEDEBUG=fixme-all,err-all,trace+winusb",
                "-w", opt_dir,
                "-e", "USB_SCRIPT=/tmp/usb-trace.txt",
            ]
            + container_mounts
            + [
                image,
                "sh", "-c",
                'mkdir -p /tmp/.wine/drive_c && cp "$1/usb.txt" /tmp/.wine/drive_c/usb.txt && exec wine64 ./identify.exe identify',
                "_", opt_dir,
            ]
        )

        proc = None
        ready_announced = False
        polling_armed = False
        contact_detected = False
        no_match_detected = False
        decrypted_label = None
        container_failed_early = False

        try:
            container_state["needs_rm"] = True
            proc = subprocess.Popen(
                cmd,
                cwd=opt_dir,
                env=clean_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                errors="replace",
                bufsize=1,
            )

            last_boot_delta = _boottime_delta()
            while True:
                cur_boot_delta = _boottime_delta()
                if (cur_boot_delta - last_boot_delta) > 2.0:
                    write_log("System suspend/resume detected via CLOCK_BOOTTIME; re-initializing sensor\n")
                    for _ in range(50):
                        if not os.path.exists("/run/synaptics-bio/suspending"):
                            break
                        time.sleep(0.2)
                    if suspend_resets < max_suspend_resets:
                        suspend_resets += 1
                        start_time = time.monotonic()
                        attempt = max(0, attempt - 1)
                    break
                last_boot_delta = cur_boot_delta

                if time.monotonic() - start_time > total_timeout:
                    write_log("Timeout waiting for fingerprint\n")
                    break

                rlist, _, _ = select.select([proc.stdout], [], [], 0.5)

                if lockscreen_mode:
                    if os.getppid() == 1 or os.getppid() != initial_ppid:
                        write_log("Parent process exited, terminating lockscreen auth session\n")
                        break

                if not rlist:
                    if proc.poll() is not None:
                        break
                    continue

                line = proc.stdout.readline()
                if not line and proc.poll() is not None:
                    break

                if not line:
                    continue

                write_log(line)

                # Sensor is armed and actively waiting for finger touch
                if not ready_announced and ("PipeID=131" in line or "libusb_interrupt_transfer=-7!" in line):
                    ready_announced = True
                    if not quiet_mode:
                        if lockscreen_mode:
                            print(f"[Fingerprint Auth] >>> Place enrolled finger to authenticate as '{target_user}' <<<", flush=True)
                        elif compact_mode:
                            print(f"[Fingerprint] Touch sensor to authenticate as '{target_user}'", flush=True)
                        else:
                            print(f"\n[Fingerprint Auth] >>> Place enrolled finger to authenticate as '{target_user}' <<<", flush=True)

                # Polling loop entered (-7! indicates sensor is actively awaiting finger touch on pipe 131)
                if ready_announced and "libusb_interrupt_transfer=-7!" in line:
                    polling_armed = True

                # Physical contact detected
                if ready_announced and not contact_detected and ("sz=80" in line or (polling_armed and "libusb_interrupt_transfer=0!" in line)):
                    contact_detected = True
                    if not quiet_mode and not lockscreen_mode:
                        print("[Fingerprint] Contact detected, scanning...", flush=True)

                # Capture decrypted payload label (cross-checked once authoritative 0x888/0x1890 buffer arrives)
                dec_lbl = bio.parse_decrypted_identity_label(line)
                if dec_lbl:
                    decrypted_label = dec_lbl

                # Authoritative IdentifyFeatureSet (0x442004) result buffer containing WINBIO_IDENTITY SID RID + rc
                id_res = bio.parse_identify_buffer(line, all_identities)
                if id_res is not None:
                    if id_res["matched"]:
                        matched_rid = id_res["rid"]
                        matched_identity = id_res["label"] or decrypted_label
                        if bio.evaluate_match(auth_rules, matched_rid, matched_identity):
                            success = True
                        else:
                            owner_name = uid_to_user.get(matched_rid) if matched_rid is not None else None
                            if owner_name:
                                wrong_user_desc = owner_name
                            elif matched_identity and matched_rid is not None:
                                wrong_user_desc = f"{matched_identity} (UID {matched_rid})"
                            elif matched_identity:
                                wrong_user_desc = matched_identity
                            elif matched_rid is not None:
                                wrong_user_desc = f"UID {matched_rid}"
                            else:
                                wrong_user_desc = "another user"
                        break
                    else:
                        no_match_detected = True
                        contact_detected = False
                        can_retry = (attempt < max_attempts) and ((total_timeout - (time.monotonic() - start_time)) > 4)
                        if not quiet_mode:
                            if can_retry:
                                print("Fingerprint not recognized, please scan again. Re-initializing sensor (~5s)...", flush=True)
                            elif lockscreen_mode:
                                print("Fingerprint not recognized. Adjust finger or use password.", flush=True)
                            else:
                                print("[Fingerprint] Not recognized. Falling back to password...", flush=True)
                        break

                # Explicit no-match error string (if not already handled by parse_identify_buffer)
                if "1f800980" in line or "WINBIO_E_NO_MATCH" in line:
                    no_match_detected = True
                    contact_detected = False
                    can_retry = (attempt < max_attempts) and ((total_timeout - (time.monotonic() - start_time)) > 4)
                    if not quiet_mode:
                        if can_retry:
                            print("Fingerprint not recognized, please scan again. Re-initializing sensor (~5s)...", flush=True)
                        elif lockscreen_mode:
                            print("Fingerprint not recognized. Adjust finger or use password.", flush=True)
                        else:
                            print("[Fingerprint] Not recognized. Falling back to password...", flush=True)
                    break

            if proc and proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=2)
                except Exception:
                    proc.kill()
            elif proc and proc.returncode in (125, 126, 127) and not ready_announced:
                # Podman itself failed to start the container (missing image, storage error, etc.)
                container_failed_early = True

        except Exception as e:
            write_log(f"Exception during auth attempt {attempt}: {e}\n")
        finally:
            clean_container_exit = False
            if proc is not None:
                if proc.poll() is None:
                    try:
                        proc.kill()
                        proc.wait(timeout=1)
                    except Exception:
                        pass
                elif proc.returncode == 0:
                    clean_container_exit = True
            if container_state["needs_rm"] and not clean_container_exit:
                try:
                    subprocess.run(
                        podman_base + ["rm", "-f", container_name],
                        env=clean_env,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=4,
                    )
                except Exception:
                    pass
            container_state["needs_rm"] = False
            if uid == 0:
                bio.ensure_calibration_permissions(opt_dir)

        if success or wrong_user_desc or container_failed_early:
            break

        if no_match_detected and ((attempt >= max_attempts) or ((total_timeout - (time.monotonic() - start_time)) <= 4)):
            break

    if success:
        if not quiet_mode:
            print(f"[Fingerprint verified for {target_user}]", flush=True)
        write_log(f"Result: SUCCESS (Target: {target_user}, RID: {matched_rid}, Label: {matched_identity})\n")
        sys.exit(0)
    elif wrong_user_desc:
        if not quiet_mode:
            if compact_mode or lockscreen_mode:
                print(f"[Fingerprint] Scanned finger belongs to '{wrong_user_desc}', not '{target_user}'.", flush=True)
            else:
                print(f"\n[Fingerprint] Scanned finger belongs to '{wrong_user_desc}', not '{target_user}'.", flush=True)
        write_log(f"Result: DENIED (Target: {target_user}, Matched RID: {matched_rid}, Label: {matched_identity})\n")
        sys.exit(1)
    else:
        if not quiet_mode and not no_match_detected:
            if lockscreen_mode:
                print("Fingerprint timeout or sensor unavailable. Adjust finger or use password.", flush=True)
            else:
                print("[Fingerprint] Sensor timeout or unavailable. Falling back to password...", flush=True)
        write_log(f"Result: FAIL/FALLBACK (Target: {target_user})\n")
        if not lockscreen_mode or bio.is_screen_locked(uid):
            try:
                subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            except Exception:
                pass
        sys.exit(1)


if __name__ == "__main__":
    main()
