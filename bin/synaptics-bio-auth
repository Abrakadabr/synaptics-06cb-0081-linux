#!/usr/bin/env python3
# /usr/local/bin/synaptics-bio-auth
# Biometric PAM helper for Synaptics 06cb:0081 Match-on-Sensor
# Supports multi-user isolation with per-user identity matching

import os
import sys
import subprocess
import time
import re
import json
import glob
import fcntl
import pwd
import signal
import select
import atexit

LOCK_PATH = "/run/lock/synaptics-bio.lock"
META_PATH = "/run/lock/synaptics-bio.meta"

def is_screen_locked(uid=None):
    """
    Check if the desktop session is currently locked via kscreenlocker or loginctl.
    """
    try:
        res = subprocess.run(["pgrep", "-x", "kscreenlocker_g"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0:
            return True
    except Exception:
        pass

    try:
        if uid is None:
            uid = os.geteuid()
        cmd = ["loginctl", "show-user", str(uid), "-p", "Display", "--value"]
        display_session = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()
        if display_session:
            cmd = ["loginctl", "show-session", display_session, "-p", "LockedHint", "--value"]
            locked = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()
            if locked == "yes":
                return True
    except Exception:
        pass

    return False

def get_proc_ppid(pid):
    try:
        with open(f"/proc/{pid}/stat", "r") as f:
            return int(f.read().split()[3])
    except Exception:
        return None

def acquire_hardware_lock(mode="interactive", timeout=2.5):
    """
    Acquires an exclusive flock on /run/lock/synaptics-bio.lock to prevent concurrent
    hardware access collisions between multiple PAM / CLI callers.
    Preempts orphaned lockscreen processes when interactive calls (sudo/polkit/CLI) arrive
    or when the session has been unlocked.
    """
    try:
        os.makedirs("/run/lock", exist_ok=True)
    except Exception:
        pass

    start_t = time.time()
    while True:
        try:
            fd = open(LOCK_PATH, "a+")
            try:
                os.chmod(LOCK_PATH, 0o666)
            except Exception:
                pass
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            # Lock acquired! Record metadata
            try:
                meta_tmp = f"{META_PATH}.tmp.{os.getpid()}"
                with open(meta_tmp, "w") as fm:
                    json.dump({"pid": os.getpid(), "mode": mode, "time": time.time()}, fm)
                os.chmod(meta_tmp, 0o666)
                os.replace(meta_tmp, META_PATH)
            except Exception:
                pass
            return fd
        except (BlockingIOError, OSError):
            pass

        # If lock couldn't be acquired, inspect current holder
        holder_pid = None
        holder_mode = None
        if os.path.exists(META_PATH):
            try:
                with open(META_PATH, "r") as fm:
                    meta = json.load(fm)
                    holder_pid = meta.get("pid")
                    holder_mode = meta.get("mode")
            except Exception:
                pass

        holder_alive = False
        if holder_pid and holder_pid != os.getpid():
            try:
                os.kill(holder_pid, 0)
                holder_alive = True
            except OSError:
                holder_alive = False

        if not holder_alive:
            time.sleep(0.1)
        else:
            should_preempt = False
            if holder_mode == "lockscreen":
                if mode != "lockscreen":
                    should_preempt = True
                elif get_proc_ppid(holder_pid) == 1 or not is_screen_locked():
                    should_preempt = True

            if should_preempt:
                try:
                    os.kill(holder_pid, signal.SIGTERM)
                except OSError:
                    pass
                clean_env = os.environ.copy()
                subprocess.run(["podman", "rm", "-f", f"synaptics-bio-auth-{holder_pid}"],
                               env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["pkill", "-x", "identify.exe"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                for _ in range(5):
                    try:
                        os.kill(holder_pid, 0)
                        time.sleep(0.1)
                    except OSError:
                        break
                else:
                    try:
                        os.kill(holder_pid, signal.SIGKILL)
                    except OSError:
                        pass
                time.sleep(0.1)
            elif mode == "lockscreen":
                return None

        if time.time() - start_t >= timeout:
            return None
        time.sleep(0.1)

def release_hardware_lock(lock_fd):
    if lock_fd:
        try:
            if os.path.exists(META_PATH):
                try:
                    with open(META_PATH, "r") as fm:
                        meta = json.load(fm)
                    if meta.get("pid") == os.getpid():
                        os.remove(META_PATH)
                except Exception:
                    pass
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            lock_fd.close()
        except Exception:
            pass

def ensure_usb_powered():
    """
    Dynamically discover the 06cb:0081 USB device path in sysfs and ensure
    autosuspend is disabled ('on').
    """
    for p in glob.glob("/sys/bus/usb/devices/*"):
        try:
            with open(os.path.join(p, "idVendor")) as fv, open(os.path.join(p, "idProduct")) as fp:
                if fv.read().strip() == "06cb" and fp.read().strip() == "0081":
                    ctrl = os.path.join(p, "power", "control")
                    if os.path.exists(ctrl):
                        with open(ctrl, "w") as fc:
                            fc.write("on\n")
                    return
        except (OSError, IOError):
            continue

def get_usb_dev_path():
    try:
        lsusb = subprocess.check_output(["lsusb"], text=True)
    except Exception:
        return None
    for line in lsusb.splitlines():
        if "06cb:0081" in line.lower() or ("synaptics" in line.lower() and "0081" in line.lower()):
            m = re.search(r"Bus\s+(\d+)\s+Device\s+(\d+)", line)
            if m:
                return f"/dev/bus/usb/{m.group(1)}/{m.group(2)}"
    return None

def extract_matched_identity(line, all_identities=None):
    """
    Extracts the biometric identity string from decrypted WinUSB trace logs
    or driver response buffers.
    Format: Decrypted: <hex string>
    The on-chip Match-on-Sensor returns a WINBIO_ID packet with Type=3 (SID),
    containing signature \x08\x00\x03\x00 (packet type 8 = match result, type 3 = SID).
    """
    if line.startswith("Decrypted:"):
        try:
            parts = line.split()
            if len(parts) >= 2:
                raw_bytes = bytes.fromhex(parts[1])
                # Check for Match Result signature: \x08\x00\x03\x00 (Type=8 Match, Subtype=3 SID)
                idx = raw_bytes.find(b'\x08\x00\x03\x00')
                if idx != -1 and len(raw_bytes) >= idx + 12:
                    id_len = int.from_bytes(raw_bytes[idx+10:idx+12], 'little')
                    if 2 <= id_len <= 32 and len(raw_bytes) >= idx + 12 + id_len:
                        ident = raw_bytes[idx+12:idx+12+id_len].rstrip(b'\x00').decode('utf-8', errors='ignore')
                        if re.match(r'^[a-zA-Z0-9_\-\.]{2,32}$', ident):
                            return ident
        except Exception:
            pass

        # Direct hex / string check for any known identity in decrypted line
        if all_identities:
            for candidate in all_identities:
                cand_hex = candidate.encode('utf-8').hex()
                if cand_hex in line:
                    return candidate

    # Also check driver return buffer: Got back 0x888 bytes: ...
    if "Got back 0x888 bytes:" in line and all_identities:
        try:
            hex_part = line.split("bytes:")[1].strip()
            raw_bytes = bytes.fromhex(hex_part)
            for candidate in all_identities:
                if candidate.encode('utf-8') in raw_bytes:
                    return candidate
        except Exception:
            pass

    return None

def main():
    # Determine target user and display mode
    lockscreen_mode = "--lockscreen" in sys.argv
    compact_mode = "--compact" in sys.argv
    quiet_mode = "--quiet" in sys.argv
    cli_args = [arg for arg in sys.argv[1:] if not arg.startswith("-")]

    target_user = None
    if cli_args:
        target_user = cli_args[0]
    if not target_user:
        target_user = os.environ.get("PAM_USER")
    if not target_user:
        target_user = os.environ.get("SUDO_USER")
    if not target_user:
        target_user = os.environ.get("USER") or "alex"

    # Check for bypass flag in root-controlled /run or /etc, or user-specific runtime dir
    if os.path.exists("/run/synaptics-bio/disable-bio-auth") or os.path.exists("/etc/synaptics-bio/disable-bio-auth"):
        sys.exit(1)

    # Check for user-specific bypass flag
    try:
        target_pw = pwd.getpwnam(target_user)
        if os.path.exists(f"/run/user/{target_pw.pw_uid}/disable-bio-auth"):
            sys.exit(1)
    except Exception:
        pass

    # Acquire hardware mutex lock to prevent concurrent sensor access collisions
    auth_mode = "lockscreen" if lockscreen_mode else "interactive"
    lock_fd = acquire_hardware_lock(mode=auth_mode)
    if not lock_fd:
        # Another process holds the sensor lock; immediately fallback to password
        sys.exit(1)

    uid = os.geteuid()
    pid = os.getpid()
    initial_ppid = os.getppid()
    container_name = f"synaptics-bio-auth-{pid}"

    # Sanitize environment unconditionally to isolate Podman & Wine from user sessions
    clean_env = os.environ.copy()
    for var in ["XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "XDG_SESSION_ID", "XDG_DATA_DIRS"]:
        clean_env.pop(var, None)
        os.environ.pop(var, None)
    clean_env["HOME"] = "/root" if os.geteuid() == 0 else os.path.expanduser("~")
    clean_env["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    os.environ["HOME"] = clean_env["HOME"]
    os.environ["PATH"] = clean_env["PATH"]

    def cleanup():
        release_hardware_lock(lock_fd)
        try:
            subprocess.run(["podman", "rm", "-f", container_name],
                           env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass

    atexit.register(cleanup)

    def sig_handler(signum, frame):
        sys.exit(1)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)
    try:
        signal.signal(signal.SIGHUP, sig_handler)
    except Exception:
        pass

    if uid == 0:
        log_file = "/var/log/synaptics-bio-auth.log"
        if not os.path.exists(log_file):
            try:
                with open(log_file, "a") as f:
                    pass
                os.chmod(log_file, 0o600)
            except Exception:
                log_file = "/tmp/synaptics-bio-auth-0.log"
    else:
        user_run = f"/run/user/{uid}"
        if os.path.isdir(user_run):
            log_file = os.path.join(user_run, "synaptics-bio-auth.log")
        else:
            log_file = f"/tmp/synaptics-bio-auth-{uid}.log"

    def write_log(msg):
        try:
            with open(log_file, "a") as f:
                f.write(msg)
        except Exception:
            pass

    # Load configured allowed biometric identities for this user
    config_file = "/opt/synaptics-bio/identities.json"
    if not os.path.exists(config_file):
        config_file = "/etc/synaptics-bio/identities.json"

    allowed_identities = {target_user}
    all_identities = {target_user, "Unicorn", "alex", "kate"}

    # Handle on-chip 7-character username truncation
    if len(target_user) > 7:
        allowed_identities.add(target_user[:7])
        all_identities.add(target_user[:7])

    if os.path.exists(config_file):
        try:
            with open(config_file, "r") as f_cfg:
                ident_map = json.load(f_cfg)
            for u, aliases in ident_map.items():
                if u.startswith("_"):
                    continue
                all_identities.add(u)
                if len(u) > 7:
                    all_identities.add(u[:7])
                if isinstance(aliases, list):
                    for a in aliases:
                        all_identities.add(a)
                        if len(a) > 7:
                            all_identities.add(a[:7])
            if target_user in ident_map and isinstance(ident_map[target_user], list):
                for alias in ident_map[target_user]:
                    allowed_identities.add(alias)
                    if len(alias) > 7:
                        allowed_identities.add(alias[:7])
        except Exception:
            pass

    # 'Unicorn' is the legacy alias for initial baseline enrollment
    if target_user == "alex":
        allowed_identities.add("Unicorn")

    # If running with root effective privileges under PAM, adopt full root credentials
    if os.geteuid() == 0:
        try:
            os.setgid(0)
            os.setuid(0)
        except Exception:
            pass

        # Only clean up legacy drop-ins if they improperly reference /var/lib/containers/storage (graphroot collision)
        for check_f in [
            "/etc/containers/storage.conf.d/99-synaptics-bio.conf",
            "/etc/containers/storage.rootless.conf.d/99-synaptics-bio.conf"
        ]:
            if os.path.exists(check_f):
                try:
                    with open(check_f, "r") as f_chk:
                        if "/var/lib/containers/storage" in f_chk.read():
                            os.remove(check_f)
                except Exception:
                    pass

    # Rotate log if larger than 1MB to prevent disk memory consumption
    try:
        if os.path.exists(log_file) and os.path.getsize(log_file) > 1024 * 1024:
            with open(log_file, "r") as f_prev:
                prev_lines = f_prev.readlines()
            with open(log_file, "w") as f_prev:
                f_prev.writelines(prev_lines[-1000:])
    except Exception:
        pass

    write_log(f"\n--- Auth attempt at {time.ctime()} (PID {pid}) ---\n")
    write_log(f"Target User: {target_user} (Allowed Identities: {sorted(list(allowed_identities))})\n")
    write_log(f"UID={os.getuid()} EUID={os.geteuid()}\n")

    if not quiet_mode:
        print(f"[Fingerprint] Sensor initializing for {target_user} (~5s)...", flush=True)

    # 1. Clean up any stale wine/identify processes or lingering containers
    subprocess.run(["pkill", "-x", "identify.exe"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["podman", "rm", "-f", container_name], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 2. Ensure USB device is awake (dynamically scan sysfs and disable autosuspend)
    ensure_usb_powered()

    # 3. Reset USB device to ensure cryptoprocessor starts in State 0
    try:
        subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    time.sleep(1.5)

    # 4. Locate USB device node dynamically
    dev_path = get_usb_dev_path()
    if not dev_path or not os.path.exists(dev_path):
        write_log("Device 06cb:0081 not found\nResult: FAIL/FALLBACK\n")
        sys.exit(1)

    opt_dir = "/opt/synaptics-bio"
    if not os.path.isdir(opt_dir):
        repo_opt = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "opt")
        if os.path.isdir(repo_opt):
            opt_dir = repo_opt
        else:
            write_log("Error: /opt/synaptics-bio directory not found\n")
            sys.exit(1)

    image_candidates = [
        "localhost/wine:validity",
        "wine:validity",
        "ghcr.io/abrakadabr/synaptics-06cb-0081-linux:latest"
    ]
    image = "localhost/wine:validity"
    for candidate in image_candidates:
        try:
            res = subprocess.run(["podman", "image", "exists", candidate], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                image = candidate
                break
        except Exception:
            pass

    success = False
    matched_identity = None
    wrong_user_match = None
    max_attempts = 3
    attempt = 0
    start_time = time.time()
    total_timeout = 30

    while attempt < max_attempts:
        attempt += 1
        elapsed = time.time() - start_time
        remaining = total_timeout - elapsed
        if remaining <= 3:
            write_log(f"Insufficient time remaining ({remaining:.1f}s) for attempt {attempt}\n")
            break

        write_log(f"--- Scan Session Attempt {attempt}/{max_attempts} (Time remaining: {remaining:.1f}s) ---\n")

        # Clean up any stale wine/identify processes or lingering containers
        subprocess.run(["pkill", "-x", "identify.exe"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["podman", "rm", "-f", container_name], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # On retries, give the USB bus and cryptoprocessor a brief moment to reset
        if attempt > 1:
            try:
                subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            except Exception:
                pass
            time.sleep(1.0)

        # Re-check device node
        dev_path = get_usb_dev_path()
        if not dev_path or not os.path.exists(dev_path):
            write_log("Device 06cb:0081 not found during retry\n")
            break

        cmd = [
            "podman", "run", "--rm",
            "--init",
            "--name", container_name,
            "--net=none",
            "--security-opt", "label=disable",
            "--device", dev_path,
            "-v", "/dev/bus/usb:/dev/bus/usb",
            "-e", "WINEPATH=/usr/lib/gcc/x86_64-w64-mingw32/10-win32;/usr/x86_64-w64-mingw32/lib",
            "-e", "WINEDEBUG=fixme-all,err-all,trace+winusb",
            "-w", opt_dir,
            "-e", "USB_SCRIPT=/tmp/usb-trace.txt",
            "-v", f"{opt_dir}:{opt_dir}",
            "-v", f"{opt_dir}/usb.txt:/root/.wine/drive_c/usb.txt",
            image,
            "sh", "-c", "wine64 ./identify.exe identify"
        ]

        proc = None
        ready_announced = False
        polling_armed = False
        contact_detected = False
        no_match_detected = False

        try:
            proc = subprocess.Popen(
                cmd,
                env=clean_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                errors="replace",
                bufsize=1
            )

            last_loop_t = time.time()
            while True:
                now_t = time.time()
                if now_t - last_loop_t > 2.0:
                    write_log("System suspend/resume detected; breaking to re-initialize sensor hardware\n")
                    break
                last_loop_t = now_t

                if time.time() - start_time > total_timeout:
                    write_log("Timeout waiting for fingerprint\n")
                    break

                rlist, _, _ = select.select([proc.stdout], [], [], 0.5)

                if lockscreen_mode:
                    if os.getppid() == 1 or os.getppid() != initial_ppid:
                        write_log("Parent process exited, terminating lockscreen auth session\n")
                        break

                if not rlist:
                    if proc.poll() is not None:
                        break
                    continue

                line = proc.stdout.readline()
                if not line and proc.poll() is not None:
                    break

                if line:
                    write_log(line)

                    # Sensor is armed and actively waiting for finger touch
                    if not ready_announced and ("PipeID=131" in line or "libusb_interrupt_transfer=-7!" in line):
                        ready_announced = True
                        if not quiet_mode:
                            if lockscreen_mode:
                                print(f"[Fingerprint Auth] >>> Place enrolled finger to authenticate as '{target_user}' <<<", flush=True)
                            elif compact_mode:
                                print(f"[Fingerprint] Touch sensor to authenticate as '{target_user}'", flush=True)
                            else:
                                print(f"\n[Fingerprint Auth] >>> Place enrolled finger to authenticate as '{target_user}' <<<", flush=True)

                    # Polling loop entered (-7! indicates sensor is actively awaiting finger touch on pipe 131)
                    if ready_announced and "libusb_interrupt_transfer=-7!" in line:
                        polling_armed = True

                    # Physical contact detected: either transfer=0! after entering polling loop, or capture data arrived (sz=80)
                    if ready_announced and not contact_detected and ("sz=80" in line or (polling_armed and "libusb_interrupt_transfer=0!" in line)):
                        contact_detected = True
                        if not quiet_mode and not lockscreen_mode:
                            if compact_mode:
                                print(f"[Fingerprint] Contact detected, scanning...", flush=True)
                            else:
                                print("[Fingerprint] Contact detected, scanning...", flush=True)

                    # Check for on-chip template match
                    matched_id = extract_matched_identity(line, all_identities)
                    if matched_id:
                        matched_identity = matched_id
                        if matched_id in allowed_identities:
                            success = True
                        else:
                            wrong_user_match = matched_id
                        break

                    # If no match occurred from on-chip comparison
                    if "1f800980" in line or "WINBIO_E_NO_MATCH" in line:
                        no_match_detected = True
                        contact_detected = False
                        can_retry = (attempt < max_attempts) and ((total_timeout - (time.time() - start_time)) > 4)
                        if not quiet_mode:
                            if can_retry:
                                print("Fingerprint not recognized, please scan again. Re-initializing sensor (~5s)...", flush=True)
                            else:
                                if lockscreen_mode:
                                    print("Fingerprint not recognized. Adjust finger or use password.", flush=True)
                                elif compact_mode:
                                    print("[Fingerprint] Not recognized. Falling back to password...", flush=True)
                                else:
                                    print("[Fingerprint] Not recognized. Falling back to password...", flush=True)
                        break

            if proc and proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=2)
                except Exception:
                    proc.kill()

        except Exception as e:
            write_log(f"Exception during auth attempt {attempt}: {e}\n")
        finally:
            if proc and proc.poll() is None:
                try:
                    proc.kill()
                except Exception:
                    pass
            try:
                subprocess.run(["podman", "rm", "-f", container_name], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
            except Exception:
                pass

        # If successfully matched or wrong user's finger matched, terminate session
        if success or wrong_user_match:
            break

        # If no match was detected and we cannot retry, exit loop
        if no_match_detected and ((attempt >= max_attempts) or ((total_timeout - (time.time() - start_time)) <= 4)):
            break

    if success:
        if not quiet_mode:
            print(f"[Fingerprint verified for {target_user}]", flush=True)
        write_log(f"Result: SUCCESS (Target: {target_user}, Matched identity: {matched_identity})\n")
        sys.exit(0)
    elif wrong_user_match:
        if not quiet_mode:
            if compact_mode:
                print(f"[Fingerprint] Scanned finger belongs to '{wrong_user_match}', not '{target_user}'.", flush=True)
            else:
                print(f"\n[Fingerprint] Scanned finger belongs to '{wrong_user_match}', not '{target_user}'.", flush=True)
        write_log(f"Result: DENIED (Target: {target_user}, but matched: {wrong_user_match})\n")
        sys.exit(1)
    else:
        write_log(f"Result: FAIL/FALLBACK (Target: {target_user})\n")
        # On failure, recover sensor by clearing state if not aborted due to session unlock
        if not lockscreen_mode or is_screen_locked(uid):
            try:
                subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            except Exception:
                pass
        sys.exit(1)

if __name__ == "__main__":
    main()
