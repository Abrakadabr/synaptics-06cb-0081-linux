#!/usr/bin/env python3
# /usr/local/bin/synaptics-bio-delete
# Fingerprint deletion and user unenrollment utility for Synaptics 06cb:0081 Match-on-Chip sensor
# Supports deleting specific finger slots (1-10) or completely unenrolling user profiles from on-chip storage.

import atexit
import json
import os
import pwd
import signal
import subprocess
import sys
import time


def _load_common():
    script_path = os.path.abspath(__file__)
    if script_path.startswith("/usr/local/bin/") or script_path.startswith("/usr/bin/"):
        search_dirs = ["/opt/synaptics-bio"]
    else:
        repo_lib = os.path.join(os.path.dirname(os.path.dirname(script_path)), "lib")
        search_dirs = [repo_lib, "/opt/synaptics-bio"]
    for d in search_dirs:
        if os.path.isdir(d) and d not in sys.path:
            sys.path.insert(0, d)


_load_common()

import synaptics_bio_common as bio  # noqa: E402


def list_enrolled_profiles(opt_dir):
    cfg_file = os.path.join(opt_dir, "identities.json")
    if not os.path.exists(cfg_file):
        print(f"No identities configuration found at {cfg_file}.")
        return

    try:
        with open(cfg_file, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print(f"Error reading {cfg_file}: {e}", file=sys.stderr)
        return

    meta = data.get("_metadata", {})
    users = set(k for k in data.keys() if not k.startswith("_")) | set(meta.keys())

    if not users:
        print("No enrolled biometric profiles registered in identities.json.")
        return

    print("==========================================================")
    print("   Enrolled Synaptics Fingerprint Biometric Profiles")
    print("==========================================================")
    for user in sorted(users):
        try:
            uinfo = pwd.getpwnam(user)
            uid_str = f"UID: {uinfo.pw_uid}"
        except Exception:
            uid_str = "UID: unknown"

        slots = meta.get(user, {}).get("enrolled_fingers", [])
        slots_str = ", ".join(f"#{s}" for s in sorted(slots)) if slots else "None"
        aliases = data.get(user, [])
        if aliases:
            formatted = [f"{a} (on-chip: {a[:7]})" if len(a) > 7 else a for a in aliases]
            alias_str = ", ".join(formatted)
        else:
            alias_str = user[:7] if len(user) > 7 else user

        print(f"User: {user} ({uid_str})")
        print(f"  Enrolled finger slots : {slots_str}")
        print(f"  Authorized identities : {alias_str}")
        print("----------------------------------------------------------")


def print_usage():
    print("Usage:")
    print("  synaptics-bio-delete --list | -l")
    print("  sudo synaptics-bio-delete <username> <slot> [options]")
    print("  sudo synaptics-bio-delete <username> --all [options]")
    print("  sudo synaptics-bio-delete unenroll <username> [options]")
    print("")
    print("Commands:")
    print("  -l, --list             List all registered users and enrolled finger slots")
    print("  <user> <slot>          Delete specific finger slot (1-10) for <user>")
    print("  <user> --all | -a      Unenroll user completely and delete all their templates")
    print("  unenroll <user>        Alias for <user> --all")
    print("")
    print("Options:")
    print("  -f, --force            Skip confirmation prompts")
    print("  -h, --help             Show this help message")
    print("")
    print("Examples:")
    print("  synaptics-bio-delete --list")
    print("  sudo synaptics-bio-delete kate 2")
    print("  sudo synaptics-bio-delete kate --all")
    print("  sudo synaptics-bio-delete unenroll alex --force")


def main():
    args = sys.argv[1:]

    if not args or "-h" in args or "--help" in args:
        print_usage()
        sys.exit(0)

    opt_dir = bio.resolve_opt_dir(__file__)
    if not opt_dir:
        print("Error: /opt/synaptics-bio directory not found.", file=sys.stderr)
        sys.exit(1)

    if "-l" in args or "--list" in args:
        list_enrolled_profiles(opt_dir)
        sys.exit(0)

    if os.geteuid() != 0:
        print("Error: Fingerprint deletion requires root privileges (use sudo).", file=sys.stderr)
        print("Example: sudo synaptics-bio-delete kate 2", file=sys.stderr)
        sys.exit(1)

    # Parse flags and positional arguments strictly before locking hardware
    force = False
    is_all = False
    positional = []
    for arg in args:
        if arg in ("-f", "--force"):
            force = True
        elif arg in ("-a", "--all"):
            is_all = True
        elif arg.startswith("-"):
            print(f"Error: Unknown option '{arg}'.", file=sys.stderr)
            print_usage()
            sys.exit(1)
        else:
            positional.append(arg)

    if positional and positional[0] == "unenroll":
        is_all = True
        positional.pop(0)
    elif "all" in positional and len(positional) >= 2:
        is_all = True
        positional.remove("all")

    target_user = None
    finger_id = None

    for arg in positional:
        if arg.isdigit():
            val = int(arg)
            if 1 <= val <= 10 and finger_id is None and target_user is not None:
                finger_id = val
            elif target_user is None and val > 10:
                # Treat numeric >10 in first position as numeric UID
                target_user = arg
            elif target_user is not None:
                print(f"Error: Finger slot must be between 1 and 10 (got '{arg}').", file=sys.stderr)
                sys.exit(1)
            else:
                finger_id = val
        elif target_user is None:
            target_user = arg
        else:
            print(f"Error: Unexpected argument '{arg}'.", file=sys.stderr)
            print_usage()
            sys.exit(1)

    if not target_user:
        target_user = os.environ.get("SUDO_USER") or os.environ.get("USER")
    if not target_user:
        try:
            target_user = pwd.getpwuid(os.getuid()).pw_name
        except Exception:
            target_user = None

    if not target_user or target_user == "root":
        print("Error: Target user could not be determined. Please specify a username:", file=sys.stderr)
        print("  sudo synaptics-bio-delete <username> <slot|--all>", file=sys.stderr)
        sys.exit(1)

    try:
        user_info = pwd.getpwnam(target_user)
        target_uid = user_info.pw_uid
    except KeyError:
        if target_user.isdigit():
            target_uid = int(target_user)
            try:
                target_user = pwd.getpwuid(target_uid).pw_name
            except Exception:
                pass
        else:
            print(f"Error: User '{target_user}' does not exist on this system.", file=sys.stderr)
            sys.exit(1)

    if not is_all and finger_id is None:
        print(f"Error: Please specify a finger slot (1-10) or --all to unenroll '{target_user}'.", file=sys.stderr)
        print("Run 'synaptics-bio-delete --list' to see enrolled slots.", file=sys.stderr)
        sys.exit(1)

    # Check identities.json for existing registration
    cfg_file = os.path.join(opt_dir, "identities.json")
    enrolled_slots = []
    if os.path.exists(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as f:
                cdata = json.load(f)
            enrolled_slots = cdata.get("_metadata", {}).get(target_user, {}).get("enrolled_fingers", [])
        except Exception:
            pass

    if not is_all and finger_id is not None and finger_id not in enrolled_slots:
        print(f"Notice: Finger slot #{finger_id} is not recorded in identities.json for user '{target_user}'.")
        if enrolled_slots:
            print(f"Currently enrolled slots for '{target_user}': {', '.join(f'#{s}' for s in enrolled_slots)}")
        else:
            print(f"User '{target_user}' currently has no enrolled finger slots recorded.")

    # Interactive confirmation prompt (before acquiring hardware lock)
    if not force:
        if is_all:
            prompt_msg = f"Are you sure you want to completely unenroll '{target_user}' and purge ALL templates from sensor? [y/N]: "
        else:
            prompt_msg = f"Delete fingerprint slot #{finger_id} for user '{target_user}'? [y/N]: "

        try:
            choice = input(prompt_msg).strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\nOperation cancelled.")
            sys.exit(1)

        if choice not in ("y", "yes"):
            print("Operation cancelled.")
            sys.exit(0)

    base_enroll_exe = os.path.join(opt_dir, "enroll.exe")
    if not os.path.exists(base_enroll_exe):
        print(f"Error: {base_enroll_exe} not found.", file=sys.stderr)
        sys.exit(1)

    # Acquire hardware mutex lock
    lock_fd = bio.acquire_hardware_lock(mode="interactive", timeout=3.0)
    if not lock_fd:
        print("Error: Another biometric process is currently accessing the sensor. Please wait and try again.", file=sys.stderr)
        sys.exit(1)

    pid = os.getpid()
    container_name = f"synaptics-bio-delete-{pid}"
    patched_exe_name = f"delete-{target_uid}-{pid}.exe"
    patched_exe_path = os.path.join(opt_dir, patched_exe_name)
    trace_file = f"usb-trace-{pid}.txt"
    trace_path = os.path.join(opt_dir, trace_file)
    clean_env = bio.get_clean_env(0)

    def cleanup():
        try:
            subprocess.run(
                ["podman", "rm", "-f", container_name],
                env=clean_env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3,
            )
        except Exception:
            pass
        for tmp_f in (patched_exe_path, trace_path):
            if os.path.exists(tmp_f):
                try:
                    os.remove(tmp_f)
                except Exception:
                    pass
        bio.release_hardware_lock(lock_fd)

    atexit.register(cleanup)

    def sig_handler(signum, frame):
        sys.exit(1)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)
    try:
        signal.signal(signal.SIGHUP, sig_handler)
    except Exception:
        pass

    print("==========================================================")
    print("   Synaptics Fingerprint Deletion")
    print("==========================================================")
    print(f"Target User : {target_user} (UID: {target_uid})")
    if is_all:
        print("Action      : UNENROLL (Purging all enrolled finger slots)")
    else:
        print(f"Action      : Delete Finger Slot #{finger_id}")
    print("==========================================================")

    # 1. Clean up stale root-owned processes/containers
    subprocess.run(["pkill", "-u", "0", "-x", "identify.exe"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["pkill", "-u", "0", "-x", "enroll.exe"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["podman", "rm", "-f", container_name], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 2. Disable USB autosuspend dynamically across sysfs
    bio.ensure_usb_powered()

    # 3. Reset USB device to ensure clean state
    print("[Fingerprint] Initializing sensor hardware...", flush=True)
    try:
        subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass
    time.sleep(1.5)

    uids_to_purge = [target_uid]
    image = bio.find_container_image(clean_env)
    deleted = False

    for idx, current_uid in enumerate(uids_to_purge):
        if idx > 0:
            time.sleep(1.5)
        dev_path = bio.get_usb_dev_path()
        if not dev_path or not os.path.exists(dev_path):
            time.sleep(1.0)
            dev_path = bio.get_usb_dev_path()
        if not dev_path or not os.path.exists(dev_path):
            print("Error: Synaptics 06cb:0081 sensor not found on USB.", file=sys.stderr)
            break

        try:
            bio.patch_delete_binary(base_enroll_exe, patched_exe_path, current_uid, None if is_all else finger_id)
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            break

        cmd = [
            "podman", "run", "--rm",
            "--init",
            "--name", container_name,
            "--net=none",
            "--cap-drop=ALL",
            "--security-opt", "label=disable",
            "--device", dev_path,
            "-e", "WINEPATH=/usr/lib/gcc/x86_64-w64-mingw32/10-win32;/usr/x86_64-w64-mingw32/lib",
            "-e", "WINEDEBUG=fixme-all,err-all",
            "-w", opt_dir,
            "-e", f"USB_SCRIPT={trace_file}",
            "-v", f"{opt_dir}:{opt_dir}",
            image,
            "sh", "-c",
            'mkdir -p /root/.wine/drive_c && cp "$1/usb.txt" /root/.wine/drive_c/usb.txt && exec wine64 "./$2"',
            "_", opt_dir, patched_exe_name,
        ]

        proc = None
        saw_delete_ioctl = False
        delete_complete_ok = False
        delete_error_hr = None
        try:
            print(f"[Fingerprint] Sending deletion command to on-chip storage (UID/RID: {current_uid})...", flush=True)
            proc = subprocess.Popen(
                cmd,
                env=clean_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                errors="replace",
                bufsize=1,
            )

            for line in proc.stdout:
                stripped = line.strip()
                if "about to 442034" in stripped:
                    saw_delete_ioctl = True
                elif saw_delete_ioctl and stripped.startswith("Complete:"):
                    if stripped == "Complete: 0":
                        delete_complete_ok = True
                    else:
                        delete_error_hr = stripped

            proc.wait()

            if saw_delete_ioctl and delete_complete_ok and proc.returncode == 0:
                deleted = True
            elif delete_error_hr:
                print(f"[Fingerprint] Sensor returned error for delete IOCTL: {delete_error_hr}", file=sys.stderr)

        except KeyboardInterrupt:
            print("\n[Fingerprint] Deletion canceled by user.", flush=True)
            break
        except Exception as e:
            print(f"\n[Fingerprint] Error during deletion (UID: {current_uid}): {e}", file=sys.stderr)
        finally:
            if proc and proc.poll() is None:
                try:
                    proc.terminate()
                    proc.wait(timeout=2)
                except Exception:
                    try:
                        proc.kill()
                    except Exception:
                        pass
            subprocess.run(["podman", "rm", "-f", container_name], env=clean_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for tmp_f in (patched_exe_path, trace_path):
                if os.path.exists(tmp_f):
                    try:
                        os.remove(tmp_f)
                    except Exception:
                        pass

        try:
            subprocess.run(["usbreset", "06cb:0081"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        except Exception:
            pass

    if deleted:
        try:
            bio.update_identities_after_delete(opt_dir, target_user, None if is_all else finger_id)
        except Exception as e:
            print(f"Warning: could not update identities.json: {e}", file=sys.stderr)
        print("")
        print("==========================================================")
        if is_all:
            print(f"Success: User '{target_user}' completely unenrolled.")
            print("All on-chip fingerprint templates have been purged.")
        else:
            print(f"Success: Finger slot #{finger_id} deleted for user '{target_user}'.")
            print("Template removed from on-chip secure storage.")
        print("==========================================================")
        sys.exit(0)
    else:
        print("\n[Fingerprint] Hardware deletion command could not be completed.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
