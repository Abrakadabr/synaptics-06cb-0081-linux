# Containerfile for Synaptics 06cb:0081 WinUSB / UMDF Execution Environment
# Builds a headless 64-bit Wine runtime equipped with the fake WinUSB stub driver
# Source repository: https://github.com/uunicorn/wine (branch: hacking/validiy-sensor)

FROM debian:bullseye AS builder

ARG WINE_COMMIT=7a69a8274f50530a5665c5dc52810710e5e05f9a

WORKDIR /root

RUN printf 'deb http://archive.debian.org/debian bullseye main\ndeb http://archive.debian.org/debian-security bullseye-security main\n' > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    build-essential \
    autoconf \
    pkg-config \
    flex \
    bison \
    fontforge \
    librsvg2-bin \
    imagemagick \
    icoutils \
    gettext \
    libgnutls28-dev \
    libgettextpo-dev \
    libxml-libxml-perl \
    libssl-dev \
    libusb-1.0.0-dev \
    gcc-mingw-w64-x86-64 \
    g++-mingw-w64-x86-64 \
    mingw-w64-tools \
    mingw-w64-x86-64-dev \
    mingw-w64 \
    mingw-w64-common && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /root/wine && cd /root/wine && \
    git init && \
    git remote add origin https://github.com/uunicorn/wine.git && \
    git fetch --depth 1 origin "${WINE_COMMIT}" && \
    git checkout FETCH_HEAD

WORKDIR /root/wine
RUN ./configure \
    --with-gnutls \
    --without-hal \
    --without-oss \
    --without-x \
    --without-freetype \
    --disable-tests \
    --enable-win64 \
    --enable-maintainer-mode \
    CFLAGS='-O2 -fdebug-prefix-map=/root/wine=. -fno-stack-protector -Wformat -Werror=format-security -Wno-error -fcommon' \
    CPPFLAGS='-Wdate-time' \
    CXXFLAGS='-O2 -fdebug-prefix-map=/root/wine=. -fno-stack-protector -Wformat -Werror=format-security' \
    LDFLAGS='-Wl,-Bsymbolic-functions -Wl,-z,relro -Wl,-z,now -Wl,-rpath,/usr/lib/x86_64-linux-gnu/wine'

RUN make -j"$(nproc)"
RUN make DESTDIR=build install

# Minimal runtime container stage
FROM debian:bullseye-slim

RUN printf 'deb http://archive.debian.org/debian bullseye main\ndeb http://archive.debian.org/debian-security bullseye-security main\n' > /etc/apt/sources.list && \
    apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends \
    libusb-1.0-0 \
    libgnutls30 \
    libssl1.1 \
    libudev1 \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/wine/build/ /
COPY --from=builder /usr/lib/gcc/x86_64-w64-mingw32/10-win32/libstdc++-6.dll \
                    /usr/lib/gcc/x86_64-w64-mingw32/10-win32/libgcc_s_seh-1.dll \
                    /usr/lib/gcc/x86_64-w64-mingw32/10-win32/libssp-0.dll \
                    /usr/lib/gcc/x86_64-w64-mingw32/10-win32/

WORKDIR /root
